{
  "name": "hash-index-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive Hash Index Simulator & API Server",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
